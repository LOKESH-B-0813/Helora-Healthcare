TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=yyyyyyyyyyyyyyyyyyyyyyyyyyyyy
TWILIO_PHONE_NUMBER=+15555555555

# Appwrite server SDK (API key must remain server-side)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=helora_healthcare
APPWRITE_USERS_TABLE_ID=users
APPWRITE_STORAGE_BUCKET_ID=helora_healthcare_files

# Firebase Admin SDK (use environment-safe values; do NOT commit private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Replace newlines in private key with literal \n sequences when storing in env
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Server secret for signing short-lived tokens
SECRET_KEY=change-me-in-production

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5500

# ---------------------------------------------------------------------------
# Medi-AI (server-side only, never exposed to the browser)
#
# GEMINI_API_KEY: your Gemini API key (REST endpoint used via query param).
#                 Put the real value in your local, git-ignored .env file.
# GEMINI_MODEL:   Gemini model id. Verified working default: gemini-2.5-flash.
#
# MEDI_AI_PROVIDER: "gemini" (default) or "dummy" (local simulation for dev/tests)
# MEDI_AI_MAX_MESSAGE_LENGTH / MEDI_AI_MAX_MESSAGES / MEDI_AI_MAX_CONTEXT_CHARS
# MEDI_AI_PROVIDER_TIMEOUT / MEDI_AI_RETRIES / MEDI_AI_MAX_OUTPUT_TOKENS
# MEDI_AI_RATE_AUTH_PER_HOUR / MEDI_AI_RATE_ANON_PER_HOUR / MEDI_AI_RATE_WINDOW_SECONDS
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
# MEDI_AI_PROVIDER=gemini 
                                                                                                                                                                                                                                                